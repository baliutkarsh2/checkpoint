# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/

# Test and coverage output
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Secrets — never commit real credentials. .env.example is the only tracked env file.
.env
.env.*
!.env.example

# Checkpoint's own run store and traces, written wherever it is invoked.
.checkpoint/
.trace.json

# Dashboard SPA development. The committed bundle lives at
# checkpoint/dashboard/static/ and IS tracked — it ships in the wheel so a
# pip install gives a working dashboard with no Node toolchain.
checkpoint/dashboard/web/node_modules/
checkpoint/dashboard/web/dist/
checkpoint/dashboard/web/*.tsbuildinfo
checkpoint/dashboard/web/test-results/
checkpoint/dashboard/web/playwright-report/
checkpoint/dashboard/web/blob-report/
checkpoint/dashboard/web/playwright/.cache/

# Editor, agent and OS droppings
.claude/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.sync-conflict-*

# Normalize line endings so the repo behaves identically on Windows, macOS, and
# Linux. Shell scripts and Dockerfiles MUST stay LF or they break inside Linux
# containers. The SPA bundle itself is not committed (it is built in CI); these
# rules keep the dashboard *sources* LF so the build is byte-identical anywhere.
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
Dockerfile      text eol=lf
entrypoint.sh   text eol=lf

# Binary assets — never munge line endings.
*.png   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

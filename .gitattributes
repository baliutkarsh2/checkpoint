# Normalize line endings so the repo behaves identically on Windows, macOS, and
# Linux. Shell scripts and Dockerfiles MUST stay LF or they break inside Linux
# containers.
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.graphql text eol=lf
*.mjs   text eol=lf
Dockerfile      text eol=lf
entrypoint.sh   text eol=lf

# Binary assets — never munge line endings.
*.png   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# The committed SPA bundle is a build artifact. Mark it binary so no platform
# rewrites its line endings; what it is checked against is a hash of the SPA
# sources (tests/test_spa_bundle.py), not its own bytes.
checkpoint/dashboard/static/** -text
